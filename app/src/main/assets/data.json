  "grammarRules": [
    {
      "id": "present_perfect",
      "topicId": "basic_tenses",
      "title": "Present Perfect Tense",
      "explanation": "Diễn tả hành động bắt đầu trong quá khứ kéo dài đến hiện tại hoặc trải nghiệm đã từng làm.",
      "structure": "[S + have/has + V3/V-ed]",
      "usage": [
        "Actions that happened at an unspecified time in the past.",
        "Actions that started in the past and continue to the present."
      ],
      "examples": [
        {
          "english": "I have seen that movie thrice.",
          "vietnamese": "Experience"
        },
        {
          "english": "The city has grown rapidly.",
          "vietnamese": "Change"
        }
      ],
      "notes": "Chú ý dùng 'have' cho chủ ngữ I/we/you/they và 'has' cho he/she/it.",
      "orderIndex": 1,
      "questions": [
        {
          "id": "pp_q1",
          "questionText": "She ___ (live) in London for three years now.",
          "options": [
            "lives",
            "lived",
            "has lived",
            "is living"
          ],
          "correctAnswerIndex": 2,
          "explanation": "We use the Present Perfect tense to talk about actions that started in the past and continue to the present (with 'for three years')."
        },
        {
          "id": "pp_q2",
          "questionText": "___ you ever ___ to Paris?",
          "options": [
            "Did / go",
            "Have / been",
            "Are / going",
            "Has / been"
          ],
          "correctAnswerIndex": 1,
          "explanation": "We use 'Have you ever been...' to ask about life experiences."
        }
      ]
    },
    {
      "id": "past_simple",
      "topicId": "basic_tenses",
      "title": "Past Simple Tense",
      "explanation": "Diễn tả hành động đã xảy ra và chấm dứt hoàn toàn trong quá khứ.",
      "structure": "[S + V2/V-ed | S + did + not + V]",
      "usage": [
        "Completed actions in the past.",
        "A series of completed actions in the past."
      ],
      "examples": [
        {
          "english": "Yesterday, I went to the cinema.",
          "vietnamese": "Hành động đã kết thúc trong quá khứ"
        },
        {
          "english": "They did not watch the match last night.",
          "vietnamese": "Phủ định thì quá khứ đơn"
        }
      ],
      "notes": "Sử dụng trạng từ nhận biết như yesterday, last night, in 2020.",
      "orderIndex": 2,
      "questions": [
        {
          "id": "ps_q1",
          "questionText": "Yesterday, I ___ (go) to the cinema.",
          "options": [
            "go",
            "goes",
            "went",
            "have gone"
          ],
          "correctAnswerIndex": 2,
          "explanation": "Yesterday indicates a completed action in the past, so we use Past Simple."
        },
        {
          "id": "ps_q2",
          "questionText": "They ___ (not / watch) the match last night.",
          "options": [
            "didn't watch",
            "don't watch",
            "didn't watched",
            "haven't watched"
          ],
          "correctAnswerIndex": 0,
          "explanation": "Negative in Past Simple uses 'didn't + base verb'."
        }
      ]
    },
    {
      "id": "modal_deduction",
      "topicId": "auxiliaries",
      "title": "Modal Verbs of Deduction",
      "explanation": "Diễn tả sự suy đoán dựa trên chứng cứ ở hiện tại.",
      "structure": "[S + must/might/can't + V]",
      "usage": [
        "Strong positive deduction (must).",
        "Strong negative deduction (can't).",
        "Possibility or uncertainty (might/could)."
      ],
      "examples": [
        {
          "english": "The lights are on. They must be at home.",
          "vietnamese": "Suy đoán khẳng định chắc chắn"
        },
        {
          "english": "She didn't answer. She might be sleeping.",
          "vietnamese": "Suy đoán có khả năng xảy ra"
        }
      ],
      "notes": "Không dùng 'mustn't' để suy đoán phủ định, thay vào đó hãy dùng 'can't'.",
      "orderIndex": 3,
      "questions": [
        {
          "id": "md_q1",
          "questionText": "The lights are on. They ___ be at home.",
          "options": [
            "must",
            "can't",
            "might not",
            "shouldn't"
          ],
          "correctAnswerIndex": 0,
          "explanation": "We use 'must' for strong positive deduction based on evidence."
        },
        {
          "id": "md_q2",
          "questionText": "She didn't answer. She ___ be sleeping.",
          "options": [
            "must",
            "might",
            "can't",
            "should"
          ],
          "correctAnswerIndex": 1,
          "explanation": "We use 'might' or 'could' for possibility (it is possible she is sleeping)."
        }
      ]
    }
  ],
